# ==============================================================================
# I-ITSM ENTERPRISE EMAIL DELIVERY CONFIGURATION
# ==============================================================================
# To receive real emails (verification OTP, SLA breach alerts, tickets) in your inbox:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Configure your SMTP provider credentials below.

# ------------------------------------------------------------------------------
# GMAIL CONFIGURATION (Recommended for quick testing)
# ------------------------------------------------------------------------------
# Steps to get a Gmail App Password:
# 1. Go to Google Account -> Security -> Enable '2-Step Verification'.
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Generate a 16-letter App Password for "ITSM System".
# 4. Paste below (without spaces):

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=your_email@gmail.com


# ------------------------------------------------------------------------------
# OUTLOOK / OFFICE 365 ALTERNATIVE
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=your_account@outlook.com
# SMTP_PASSWORD=your_password
# SMTP_FROM=your_account@outlook.com
